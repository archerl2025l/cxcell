<Window x:Class="CxCell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="50"
        Height="92"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border Background="#E6171D20"
            CornerRadius="12"
            Padding="5">
        <StackPanel x:Name="BatteryStack"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
    </Border>
</Window>
